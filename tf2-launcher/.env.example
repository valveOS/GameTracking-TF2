# Steam Account Credentials
STEAM_USERNAME=your_steam_account_here
STEAM_PASSWORD=your_steam_password_here

# Steam 2FA TOTP Secret (base32 encoded)
# Get this from Steam Guard settings
STEAM_TOTP_SECRET=your_2fa_secret_here

# TF2 Installation Path
# Adjust based on your operating system:

# Windows Example:
# TF2_GAME_DIR=C:\Program Files (x86)\Steam\steamapps\common\Team Fortress 2

# macOS Example:
# TF2_GAME_DIR=/Users/username/Library/Application Support/Steam/steamapps/common/Team Fortress 2

# Linux Example:
TF2_GAME_DIR=/home/username/.steam/steamapps/common/Team Fortress 2

# TF2 Launch Parameters
# Add any additional launch parameters here
# Examples: -console -nohltv -no_soundscape
TF2_LAUNCH_PARAMS=-console -nohltv

# Game Coordinator Settings
GAME_COORDINATOR_TIMEOUT=5000

# Resource Optimization
# Maximum memory in MB (default: 256)
MAX_MEMORY=256

# Garbage collection interval in ms (default: 60000 = 60 seconds)
GC_INTERVAL=60000

# Debug mode (true/false)
DEBUG=false

# Logging level (info, warn, error, debug)
LOG_LEVEL=info
